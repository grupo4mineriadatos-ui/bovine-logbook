      "parameters": {
        "jsCode": "const webhookData = $('Webhook').first().json.body || $('Webhook').first().json;\nconst vacaMaestra = $input.first().json;\n\nconst gestationPeriod = 283;\nlet fecha_estimacion = \"\";\n\n// Normalizamos nombres de variables por si desde Lovable llegan con mayúsculas o tildes\nconst diasGestacion = webhookData.dias_gestacion || webhookData.días_gestacion || 0;\nconst resultadoTacto = webhookData.Resultado_tacto || webhookData.tacto || \"No especificado\";\n\n// Solo calculamos si hay dias de gestacion y el tacto no es negativo\nif (diasGestacion > 0 && resultadoTacto.toLowerCase() !== 'negativo') {\n  const diasRestantes = gestationPeriod - Number(diasGestacion);\n  const fechaBase = webhookData.Fecha_del_Tacto ? DateTime.fromISO(webhookData.Fecha_del_Tacto) : DateTime.now();\n  fecha_estimacion = fechaBase.plus({ days: diasRestantes }).toFormat('yyyy-MM-dd');\n}\n\nreturn {\n  json: {\n    Fecha_del_Tacto: webhookData.Fecha_del_Tacto || DateTime.now().toFormat('yyyy-MM-dd'),\n    Caravana: vacaMaestra.Caravana,\n    Resultado_tacto: resultadoTacto,\n    días_gestacion: diasGestacion || \"\",\n    fecha_estimacion_parto: fecha_estimacion\n  }\n};"
